# ---------------------------------------------------------------------------
# Storefront environment — PUBLIC values only.
# Everything here is bundled into the client and exposed to the SSR output;
# NEVER put backend secrets (JWT, DB, S3, gateway keys, Sentry DSN) in a
# VITE_* variable.
#
# REQUIRED
#   VITE_API_URL         Backend API base URL.
#   VITE_PUBLIC_ORIGIN   Public storefront origin (canonical URLs / Open Graph).
#
# PRODUCTION
#   VITE_API_URL         https://api.example.com/api/v1  (must be in the
#                        backend CLIENT_ORIGIN allow-list — credentials are only
#                        granted to listed origins, and cookies require it).
#   VITE_PUBLIC_ORIGIN   https://www.example.com  (canonical/OG origin; must be
#                        HTTPS with no mixed content).
#   See docs/PRODUCTION_OPERATIONS.md §12 for secret handling.
# ---------------------------------------------------------------------------

# Public backend API URL used by the storefront.
VITE_API_URL=http://localhost:4000/api/v1

# Public storefront origin (used for canonical URLs / Open Graph).
VITE_PUBLIC_ORIGIN=http://localhost:8090
