# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# MongoDB â€” use a placeholder; never commit real credentials.
# Local:   mongodb://127.0.0.1:27017/enterprise-commerce-hub
# Atlas:   mongodb+srv://<db-user>:<db-password>@<cluster-host>/<dbname>?retryWrites=true
MONGO_URI=mongodb://127.0.0.1:27017/enterprise-commerce-hub
MONGO_DEBUG=false

# JWT (use strong random secrets in production â€” e.g. `openssl rand -hex 64`; min 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-fedcba9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookies
COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
# MUST be true in production (HTTPS only); the server refuses to start in
# production with COOKIE_SECURE=false.
COOKIE_SECURE=false

# CORS â€” admin console origin(s), comma separated. Use exact HTTPS origins in
# production (never a wildcard when credentials are enabled).
CLIENT_ORIGIN=http://localhost:8080

# Logging
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Error monitoring (OPTIONAL) â€” Sentry. Leave unset in development/CI.
# The integration is a no-op without SENTRY_DSN, so no credentials are ever
# required locally. Before production, install the Sentry SDK (@sentry/node),
# set SENTRY_DSN / SENTRY_ENVIRONMENT, and re-run the security checks.
# Never put the DSN in a frontend (VITE_*) variable â€” it is server-only.
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Media storage (local is for development; uploaded files are gitignored).
# Local mode needs no credentials â€” it stores files in UPLOAD_DIR and serves
# them from /media-files on the same process.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MEDIA_PUBLIC_URL=http://localhost:4000/media-files
MEDIA_MAX_FILE_SIZE_BYTES=5242880
# Decompression-bomb guard: maximum decoded pixels (width * height) accepted.
MEDIA_MAX_IMAGE_PIXELS=60000000

# ---------------------------------------------------------------------------
# Production object storage (S3-compatible) â€” OPTIONAL, only when
# STORAGE_PROVIDER=s3. Local mode ignores all of the following.
# Works with AWS S3, Cloudflare R2 (via endpoint), MinIO, DigitalOcean Spaces,
# Google Cloud Storage (via the S3-interop), etc. Never commit real credentials.
# ---------------------------------------------------------------------------


# Uploaded images are served from MEDIA_PUBLIC_URL in BOTH modes. In local mode
# this is the in-process /media-files origin. In S3/CDN mode, point this at your
# CDN origin (the bucket/key layout is unchanged â€” only the host changes), so
# existing Media.url values keep resolving.

# ---------------------------------------------------------------------------
# Customer (storefront) auth  (Phase 3)
# ---------------------------------------------------------------------------
# Use strong unique secrets in production (min 32 chars).
CUSTOMER_JWT_ACCESS_SECRET=dev-customer-access-secret-0123456789abcdef
CUSTOMER_ACCESS_TOKEN_TTL=15m
CUSTOMER_REFRESH_TOKEN_TTL_DAYS=7
CUSTOMER_COOKIE_NAME=customer_refresh_token

# ---------------------------------------------------------------------------
# Customer social sign-in — Google & Facebook (OPTIONAL, backend-only secrets)
# ---------------------------------------------------------------------------
# Leave both ID and SECRET empty to disable the provider (the social buttons
# then land back on the storefront with a "provider unavailable" message).
#
# GOOGLE (Google Cloud Console → APIs & Services → Credentials → OAuth client ID):
#   1. Application type: Web application
#   2. Authorised redirect URI (must match EXACTLY, including no trailing slash):
#      http://localhost:4000/api/v1/auth/customer/google/callback
#      (production: https://api.your-domain.com/api/v1/auth/customer/google/callback
#       — or set GOOGLE_REDIRECT_URI if it differs from BACKEND_PUBLIC_URL)
#   3. Copy the Client ID / Client secret here. NEVER commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional override (defaults to ${BACKEND_PUBLIC_URL}/api/v1/auth/customer/google/callback):
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/customer/google/callback
#
# FACEBOOK (Meta for Developers → your App → Facebook Login → Settings):
#   1. Valid OAuth Redirect URIs (must match EXACTLY):
#      http://localhost:4000/api/v1/auth/customer/facebook/callback
#      (production: https://api.your-domain.com/api/v1/auth/customer/facebook/callback
#       — or set FACEBOOK_REDIRECT_URI if it differs from BACKEND_PUBLIC_URL)
#   2. Copy the App ID / App secret here. NEVER commit real values.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Optional override (defaults to ${BACKEND_PUBLIC_URL}/api/v1/auth/customer/facebook/callback):
# FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/customer/facebook/callback

# ---------------------------------------------------------------------------
# Online payments — Cybersource Unified Checkout (card) + Fonepay QR.
# Placeholders only. NEVER commit real gateway credentials.
# - Cybersource: key id + HTTP-Signature shared secret from Business Center →
#   Payment Configuration → Key Management. CYBERSOURCE_CURRENCY must match
#   the currency actually enabled on the merchant account.
# - Fonepay: merchant API username/password + PKCS8 private key (Base64/HEX,
#   no PEM headers) + terminal id from Fonepay merchant onboarding.
# Both are optional at boot; a half-configured set refuses to start in
# production. Orders default to PAYMENT_DEFAULT_CURRENCY for COD records.
# ---------------------------------------------------------------------------
PAYMENT_DEFAULT_CURRENCY=NPR

CYBERSOURCE_ENVIRONMENT=test
CYBERSOURCE_MERCHANT_ID=your-cybersource-merchant-id
CYBERSOURCE_KEY_ID=your-cybersource-key-id
CYBERSOURCE_SHARED_SECRET=your-cybersource-shared-secret
# Optional portfolio/organization id (multi-org merchants only):
# CYBERSOURCE_ORGANIZATION_ID=
CYBERSOURCE_CURRENCY=USD
CYBERSOURCE_LOCALE=en_US
CYBERSOURCE_COUNTRY=US
CYBERSOURCE_ALLOWED_CARD_NETWORKS=VISA,MASTERCARD
CYBERSOURCE_ALLOWED_PAYMENT_TYPES=CARD
CYBERSOURCE_REQUEST_TIMEOUT_MS=15000
CYBERSOURCE_COMPLETE_MANDATE_ENABLED=true
# HTTPS origins allowed to render Unified Checkout (defaults to CLIENT_ORIGIN):
# CYBERSOURCE_TARGET_ORIGINS=https://localhost:8090

# Fonepay QR / Intent Checkout — disabled unless EXPLICITLY enabled.
# FONEPAY_ENABLED defaults to false: while it is unset/false the gateway stays
# unregistered, checkout does not offer it, and every Fonepay attempt fails
# fast with 503. To go live, set FONEPAY_ENABLED=true AND the full credential
# set below — enabling it without them refuses to start. In production,
# FONEPAY_ENVIRONMENT must additionally be exactly "production".
# Terminal id must be <= 16 characters; the private key is a PKCS8 RSA key
# (Base64 or hex, WITHOUT PEM headers). Values come from Fonepay merchant
# onboarding — never placeholders.
# FONEPAY_ENABLED=false
# FONEPAY_ENVIRONMENT=uat            # "uat" | "production" (required when enabled)
# FONEPAY_BASE_URL=https://uat-new-merchant-api.fonepay.com
# FONEPAY_USERNAME=
# FONEPAY_PASSWORD=
# FONEPAY_PRIVATE_KEY=
# FONEPAY_TERMINAL_ID=
# FONEPAY_REQUEST_TIMEOUT_MS=15000


PUBLIC_BASE_URL=http://localhost:8090
