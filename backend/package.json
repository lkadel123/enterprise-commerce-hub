{
  "name": "enterprise-commerce-hub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API backend for the Enterprise Commerce Hub admin console",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "seed": "tsx src/database/seed.ts",
    "check:prod-security": "tsx scripts/check-prod-security.ts",
    "backup": "tsx scripts/backup-restore.ts",
    "backup:dry-run": "tsx scripts/backup-restore.ts --dry-run",
    "live": "tsx scripts/live-backend.mts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
